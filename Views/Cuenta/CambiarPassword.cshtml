@model CambiarPasswordVM
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="page-header">
    <h1 class="page-title"><i class="bi bi-key-fill"></i> Cambiar contraseña</h1>
</div>

<div class="card" style="max-width: 480px">
    <div class="card-body p-4">
        <form asp-action="CambiarPassword" method="post">
            <div class="mb-3">
                <label asp-for="Actual" class="form-label"></label>
                <input asp-for="Actual" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Actual" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nueva" class="form-label"></label>
                <input asp-for="Nueva" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Nueva" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Confirmar" class="form-label"></label>
                <input asp-for="Confirmar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Confirmar" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> Guardar</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
