@model ReporteAnualVM
@{
    ViewData["Title"] = "Reporte mensual";
    var totalVendido = Model.Meses.Sum(m => m.TotalVendido);
    var totalCosto = Model.Meses.Sum(m => m.CostoVendido);
    var totalGanancia = Model.Meses.Sum(m => m.Ganancia);
    var totalRecaudado = Model.Meses.Sum(m => m.TotalRecaudado);
    var totalPendiente = Model.Meses.Sum(m => m.PendientePorCobrar);
    decimal? margenAnual = totalVendido > 0 ? totalGanancia * 100 / totalVendido : null;
    var mesActual = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-bar-chart-fill"></i> Reporte mes a mes</h1>
        <p class="page-sub">Ventas, ganancias, recaudo y cartera del año @Model.Anio</p>
    </div>
    <form method="get" class="d-flex gap-2 align-items-center no-print">
        <select name="anio" class="form-select" onchange="this.form.submit()">
            @foreach (var a in Model.AniosDisponibles)
            {
                <option value="@a" selected="@(a == Model.Anio)">@a</option>
            }
        </select>
        <button type="button" onclick="window.print()" class="btn btn-soft text-nowrap"><i class="bi bi-printer"></i> Imprimir</button>
    </form>
</div>

@if (Model.HayCostosIncompletos)
{
    <div class="alert alert-danger small">
        <i class="bi bi-info-circle me-1"></i>
        Algunas ventas de este año tienen productos <strong>sin precio de compra</strong>, así que la ganancia aparece más alta de lo real.
        <a asp-controller="Productos" asp-action="Index">Agrega el precio de compra a tus productos</a> y se completa automáticamente.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi kpi-destacado">
            <div class="kpi-icono"><i class="bi bi-cash-stack"></i></div>
            <div><div class="kpi-label">Total vendido @Model.Anio</div><div class="kpi-valor">@totalVendido.Cop()</div>
                <div class="kpi-extra">@Model.Meses.Sum(m => m.NumeroVentas) ventas · @Model.Meses.Sum(m => m.UnidadesVendidas) unidades</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi">
            <div class="kpi-icono verde"><i class="bi bi-graph-up-arrow"></i></div>
            <div><div class="kpi-label">Ganancia</div><div class="kpi-valor @(totalGanancia >= 0 ? "text-pagado" : "text-deuda")">@totalGanancia.Cop()</div>
                <div class="kpi-extra">Costo @totalCosto.Cop()@(margenAnual.HasValue ? $" · margen {margenAnual:0}%" : "")</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi">
            <div class="kpi-icono"><i class="bi bi-wallet2"></i></div>
            <div><div class="kpi-label">Total recaudado</div><div class="kpi-valor">@totalRecaudado.Cop()</div><div class="kpi-extra">Dinero que realmente entró</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi">
            <div class="kpi-icono naranja"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="kpi-label">Pendiente por cobrar</div><div class="kpi-valor text-deuda">@totalPendiente.Cop()</div><div class="kpi-extra">De las ventas del año</div></div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-graph-up me-1"></i> Vendido, recaudado y ganancia</div>
    <div class="card-body"><canvas id="grafico" height="90"></canvas></div>
</div>

<div class="row g-3">
    <div class="col-xxl-8">
        <div class="card">
            <div class="card-header"><i class="bi bi-table me-1"></i> Detalle por mes</div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mes</th><th class="text-center">Ventas</th><th class="text-center">Und.</th>
                            <th class="text-end">Vendido</th><th class="text-end">Costo</th><th class="text-end">Ganancia</th><th class="text-end">Margen</th>
                            <th class="text-end">Recaudado</th><th class="text-end">Pendiente</th><th class="no-print"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Meses)
                        {
                            var esFuturo = new DateTime(m.Anio, m.Mes, 1) > mesActual;
                            <tr class="@(esFuturo ? "text-secondary opacity-50" : "")">
                                <td class="fw-bold">@Formato.NombreMes(m.Mes)</td>
                                <td class="text-center">@m.NumeroVentas</td>
                                <td class="text-center">@m.UnidadesVendidas</td>
                                <td class="text-end fw-semibold">@m.TotalVendido.Cop()</td>
                                <td class="text-end text-secondary">@m.CostoVendido.Cop()</td>
                                <td class="text-end fw-bold @(m.Ganancia >= 0 ? "text-pagado" : "text-deuda")">@m.Ganancia.Cop()</td>
                                <td class="text-end">@(m.Margen.HasValue ? $"{m.Margen:0}%" : "—")</td>
                                <td class="text-end">@m.TotalRecaudado.Cop()</td>
                                <td class="text-end @(m.PendientePorCobrar > 0 ? "text-deuda" : "")">@m.PendientePorCobrar.Cop()</td>
                                <td class="text-end no-print">
                                    @if (m.NumeroVentas > 0)
                                    {
                                        <a asp-controller="Ventas" asp-action="Index" asp-route-mes="@($"{m.Anio}-{m.Mes:00}")" class="btn btn-soft btn-icono" title="Ver ventas del mes"><i class="bi bi-eye"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>TOTAL @Model.Anio</td>
                            <td class="text-center">@Model.Meses.Sum(m => m.NumeroVentas)</td>
                            <td class="text-center">@Model.Meses.Sum(m => m.UnidadesVendidas)</td>
                            <td class="text-end">@totalVendido.Cop()</td>
                            <td class="text-end">@totalCosto.Cop()</td>
                            <td class="text-end text-pagado">@totalGanancia.Cop()</td>
                            <td class="text-end">@(margenAnual.HasValue ? $"{margenAnual:0}%" : "—")</td>
                            <td class="text-end">@totalRecaudado.Cop()</td>
                            <td class="text-end">@totalPendiente.Cop()</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <p class="small text-secondary mt-2 mb-0">
            <strong>Ganancia</strong> = lo vendido − lo que costaron esos productos (precio de compra), según la fecha de la venta.
            Incluye ventas que aún no te han pagado completas.
        </p>
    </div>
    <div class="col-xxl-4">
        <div class="card">
            <div class="card-header"><i class="bi bi-trophy me-1"></i> Más vendidos del año</div>
            <ul class="list-group list-group-flush">
                @if (!Model.TopProductos.Any())
                {
                    <li class="list-group-item vacio py-4"><i class="bi bi-trophy"></i>Sin ventas este año</li>
                }
                @{ var maxUnd = Model.TopProductos.Any() ? Model.TopProductos.Max(t => t.Unidades) : 1; var pos = 1; }
                @foreach (var t in Model.TopProductos)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold"><span class="text-azul me-1">@(pos++).</span> @t.Producto</span>
                            <span class="small">@t.Unidades und.</span>
                        </div>
                        <div class="progress my-1"><div class="progress-bar" style="width:@(t.Unidades * 100 / maxUnd)%"></div></div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-secondary">Vendido @t.Total.Cop()</span>
                            <span class="fw-bold @(t.Ganancia >= 0 ? "text-pagado" : "text-deuda")">Ganancia @t.Ganancia.Cop()</span>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const datos = @Json.Serialize(Model.Meses.Select(m => new {
            mes = Formato.NombreMes(m.Mes).Substring(0, 3),
            vendido = m.TotalVendido,
            recaudado = m.TotalRecaudado,
            ganancia = m.Ganancia
        }));
        new Chart(document.getElementById('grafico'), {
            data: {
                labels: datos.map(d => d.mes),
                datasets: [
                    { type: 'bar', label: 'Vendido', data: datos.map(d => d.vendido), backgroundColor: '#3D8BEA', borderRadius: 8 },
                    { type: 'bar', label: 'Recaudado', data: datos.map(d => d.recaudado), backgroundColor: '#A9D3FB', borderRadius: 8 },
                    { type: 'line', label: 'Ganancia', data: datos.map(d => d.ganancia), borderColor: '#1C3F7A', backgroundColor: '#1C3F7A', tension: .35, pointRadius: 4 }
                ]
            },
            options: {
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'Nunito', weight: 700 } } },
                    tooltip: { callbacks: { label: c => c.dataset.label + ': ' + cop(c.raw) } }
                },
                scales: {
                    y: { beginAtZero: true, suggestedMax: 100000, ticks: { callback: v => cop(v) }, grid: { color: '#EAF5FF' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
