@model Gasto
@{
    bool nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo gasto" : "Editar gasto";
    var categorias = (List<string>)ViewBag.Categorias;
    var conceptos = (List<string>)ViewBag.Conceptos;
}

<div class="page-header">
    <h1 class="page-title"><i class="bi @(nuevo ? "bi-plus-lg" : "bi-pencil")"></i> @ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-soft"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="card" style="max-width: 760px">
    <div class="card-body p-4">
        <form asp-action="@(nuevo ? "Create" : "Edit")" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            @if (nuevo)
            {
                <label class="form-label">Atajos</label>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-sm btn-soft atajo" data-concepto="CapCut Pro" data-categoria="Suscripciones y apps"><i class="bi bi-scissors"></i> CapCut Pro</button>
                    <button type="button" class="btn btn-sm btn-soft atajo" data-concepto="Gasolina" data-categoria="Transporte y gasolina"><i class="bi bi-fuel-pump"></i> Gasolina</button>
                    <button type="button" class="btn btn-sm btn-soft atajo" data-concepto="Publicidad Instagram" data-categoria="Publicidad"><i class="bi bi-instagram"></i> Publicidad IG</button>
                    <button type="button" class="btn btn-sm btn-soft atajo" data-concepto="Bolsas y empaques" data-categoria="Empaques y envíos"><i class="bi bi-bag"></i> Empaques</button>
                    <button type="button" class="btn btn-sm btn-soft atajo" data-concepto="Envío / domicilio" data-categoria="Empaques y envíos"><i class="bi bi-truck"></i> Envío</button>
                    <button type="button" class="btn btn-sm btn-soft atajo" data-concepto="Plan de celular" data-categoria="Servicios (internet, celular)"><i class="bi bi-phone"></i> Plan celular</button>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Concepto" class="form-label"></label>
                    <input asp-for="Concepto" class="form-control" list="listaConceptos" placeholder="Ej: CapCut Pro, gasolina moto…" autofocus />
                    <datalist id="listaConceptos">
                        @foreach (var c in conceptos) { <option value="@c"></option> }
                    </datalist>
                    <span asp-validation-for="Concepto" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Categoria" class="form-label"></label>
                    <input asp-for="Categoria" class="form-control" list="listaCategorias" placeholder="Elige o escribe una" />
                    <datalist id="listaCategorias">
                        @foreach (var c in categorias) { <option value="@c"></option> }
                    </datalist>
                    <span asp-validation-for="Categoria" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Monto" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Monto" type="number" min="1" step="any" class="form-control" />
                        <span class="input-group-text">COP</span>
                    </div>
                    <span asp-validation-for="Monto" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MetodoPago" class="form-label"></label>
                    <select asp-for="MetodoPago" asp-items="@(new SelectList(Pago.Metodos))" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Nota" class="form-label"></label>
                    <input asp-for="Nota" class="form-control" placeholder="Opcional" />
                </div>
            </div>

            <div class="small text-secondary mt-3">
                <i class="bi bi-info-circle"></i> La mercancía que compras para vender <strong>no</strong> va aquí:
                eso ya se descuenta de la ganancia con el <em>precio de compra</em> de cada producto.
            </div>

            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-soft">Cancelar</a>
                <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.atajo').forEach(b => b.addEventListener('click', () => {
            document.getElementById('Concepto').value = b.dataset.concepto;
            document.getElementById('Categoria').value = b.dataset.categoria;
            document.getElementById('Monto').focus();
        }));
    </script>
}
