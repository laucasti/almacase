@model List<Producto>
@{
    ViewData["Title"] = "Productos";
    var categorias = (List<string>)ViewBag.Categorias;
    bool inactivos = ViewBag.Inactivos;
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-phone-fill"></i> Productos</h1>
        <p class="page-sub">@Model.Count producto(s) · @Model.Sum(p => p.Cantidad) unidades · valor @Model.Sum(p => p.Cantidad * p.Precio).Cop()</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Nombre o descripción…" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Categoría</label>
                <select name="categoria" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var c in categorias)
                    {
                        <option value="@c" selected="@(c == (string?)ViewBag.Categoria)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="inactivos" value="true" id="chkInactivos" checked="@inactivos" />
                    <label class="form-check-label" for="chkInactivos">Ver inactivos</label>
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-soft"><i class="bi bi-funnel"></i> Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Producto</th><th>Categoría</th><th class="text-center">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Valor en stock</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="vacio"><i class="bi bi-phone"></i>No hay productos. ¡Agrega el primero!</td></tr>
                }
                @foreach (var p in Model)
                {
                    var badge = p.Cantidad == 0 ? "badge-agotado" : p.Cantidad <= AlmaCase.Controllers.HomeController.StockMinimo ? "badge-stock-bajo" : "badge-stock-ok";
                    <tr>
                        <td>
                            <div class="fw-bold">@p.Nombre</div>
                            @if (!string.IsNullOrEmpty(p.Descripcion)) { <small class="text-secondary">@p.Descripcion</small> }
                        </td>
                        <td>@if (!string.IsNullOrEmpty(p.Categoria)) { <span class="badge badge-categoria">@p.Categoria</span> }</td>
                        <td class="text-center"><span class="badge @badge">@(p.Cantidad == 0 ? "Agotado" : p.Cantidad.ToString())</span></td>
                        <td class="text-end fw-semibold">@p.Precio.Cop()</td>
                        <td class="text-end">@((p.Cantidad * p.Precio).Cop())</td>
                        <td class="text-end text-nowrap">
                            @if (p.Activo)
                            {
                                <button type="button" class="btn btn-soft btn-icono" title="Agregar stock"
                                        data-bs-toggle="modal" data-bs-target="#modalStock" data-id="@p.Id" data-nombre="@p.Nombre">
                                    <i class="bi bi-box-arrow-in-down"></i>
                                </button>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-soft btn-icono" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirm="¿Eliminar &quot;@p.Nombre&quot;?">
                                    <button class="btn btn-soft btn-icono text-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reactivar" asp-route-id="@p.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-counterclockwise"></i> Reactivar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: agregar stock -->
<div class="modal fade" id="modalStock" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <form asp-action="AgregarStock" method="post" class="modal-content" style="border-radius:1.25rem">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-box-arrow-in-down text-azul"></i> Agregar stock</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body pt-0">
                <p class="text-secondary mb-2" id="stockNombre"></p>
                <input type="hidden" name="id" id="stockId" />
                <label class="form-label">Unidades que llegaron</label>
                <input type="number" name="cantidad" min="1" value="1" class="form-control" required />
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-primary w-100">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalStock').addEventListener('show.bs.modal', e => {
            document.getElementById('stockId').value = e.relatedTarget.dataset.id;
            document.getElementById('stockNombre').textContent = e.relatedTarget.dataset.nombre;
        });
    </script>
}
