@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-people-fill"></i> Clientes</h1>
        <p class="page-sub">@Model.Count cliente(s) registrados</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Nuevo cliente</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre, teléfono, documento o Instagram…" />
            </div>
            <button class="btn btn-soft">Buscar</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>Cliente</th><th>Contacto</th><th>Ciudad</th><th class="text-center">Compras</th><th class="text-end">Total comprado</th><th class="text-end">Debe</th><th></th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="vacio"><i class="bi bi-people"></i>No hay clientes registrados</td></tr>
                }
                @foreach (var c in Model)
                {
                    var deuda = c.Ventas.Sum(v => Math.Max(v.Saldo, 0));
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@c.Nombre.Substring(0, 1).ToUpper()</span>
                                <div>
                                    <a asp-action="Details" asp-route-id="@c.Id" class="fw-bold text-decoration-none">@c.Nombre</a>
                                    @if (!string.IsNullOrEmpty(c.Documento)) { <div class="small text-secondary">CC @c.Documento</div> }
                                </div>
                            </div>
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(c.Telefono)) { <div><i class="bi bi-whatsapp text-success"></i> @c.Telefono</div> }
                            @if (!string.IsNullOrEmpty(c.Instagram)) { <div><i class="bi bi-instagram text-azul"></i> @c.Instagram</div> }
                        </td>
                        <td>@c.Ciudad</td>
                        <td class="text-center">@c.Ventas.Count</td>
                        <td class="text-end">@c.Ventas.Sum(v => v.Total).Cop()</td>
                        <td class="text-end">
                            @if (deuda > 0) { <span class="text-deuda fw-bold">@deuda.Cop()</span> }
                            else { <span class="badge badge-pagada">Al día</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="Ventas" asp-action="Create" asp-route-clienteId="@c.Id" class="btn btn-soft btn-icono" title="Nueva venta"><i class="bi bi-bag-plus"></i></a>
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-soft btn-icono" title="Ver"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-soft btn-icono" title="Editar"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
