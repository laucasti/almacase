@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string c, string? a = null) =>
        ctrl == c && (a == null || accion == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Alma Case</title>
    <link rel="icon" type="image/png" href="~/img/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Barra superior (solo celular) -->
    <header class="topbar d-lg-none">
        <button class="btn btn-link text-white fs-3 p-0" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Abrir menú">
            <i class="bi bi-list"></i>
        </button>
        <img src="~/img/logo.png" alt="Alma Case" class="topbar-logo" />
        <span class="brand-text">Alma Case</span>
    </header>

    <div class="app">
        <aside id="sidebar" class="sidebar offcanvas-lg offcanvas-start" tabindex="-1">
            <div class="offcanvas-header d-lg-none">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Cerrar"></button>
            </div>
            <div class="sidebar-inner">
                <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                    <img src="~/img/logo.png" alt="Alma Case — Tecnología y tendencia" />
                </a>
                <nav class="nav flex-column">
                    <span class="nav-section">General</span>
                    <a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Inicio</a>

                    <span class="nav-section">Gestión</span>
                    <a class="nav-link @Activo("Productos")" asp-controller="Productos" asp-action="Index"><i class="bi bi-phone-fill"></i> Productos</a>
                    <a class="nav-link @Activo("Clientes")" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people-fill"></i> Clientes</a>
                    <a class="nav-link @(ctrl == "Ventas" && accion != "Pendientes" ? "active" : "")" asp-controller="Ventas" asp-action="Index"><i class="bi bi-bag-heart-fill"></i> Ventas</a>
                    <a class="nav-link @Activo("Ventas", "Pendientes")" asp-controller="Ventas" asp-action="Pendientes"><i class="bi bi-hourglass-split"></i> Por cobrar</a>
                    <a class="nav-link @Activo("Gastos")" asp-controller="Gastos" asp-action="Index"><i class="bi bi-receipt-cutoff"></i> Gastos</a>

                    <span class="nav-section">Análisis</span>
                    <a class="nav-link @Activo("Reportes")" asp-controller="Reportes" asp-action="Index"><i class="bi bi-bar-chart-fill"></i> Reporte mensual</a>
                </nav>
                <a asp-controller="Ventas" asp-action="Create" class="btn btn-light btn-nueva-venta">
                    <i class="bi bi-plus-circle-fill"></i> Nueva venta
                </a>
                <div class="sidebar-footer">
                    <div class="sidebar-usuario"><i class="bi bi-person-circle"></i> @User.Identity?.Name</div>
                    <div class="d-flex justify-content-center gap-2 mt-2">
                        <a asp-controller="Cuenta" asp-action="CambiarPassword" class="btn btn-sm btn-sidebar" title="Cambiar contraseña"><i class="bi bi-key"></i></a>
                        <form asp-controller="Cuenta" asp-action="Logout" method="post">
                            <button class="btn btn-sm btn-sidebar"><i class="bi bi-box-arrow-right"></i> Salir</button>
                        </form>
                    </div>
                    <div class="mt-3">@@AlmaCase.col</div>
                </div>
            </div>
        </aside>

        <main class="content">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@err
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
